{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window. Grants clipboard write + URL opener.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-url",
    "clipboard-manager:default",
    "clipboard-manager:allow-write-text"
  ]
}
