{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "神谕 · Oracle Desktop",
  "version": "1.0.0",
  "identifier": "com.thatgfsj.oracle-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "神谕 · Oracle Desktop",
        "width": 880,
        "height": 700,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/ios/AppIcon-512@2x.png"
    ],
    "category": "Lifestyle",
    "shortDescription": "塔罗镜 + 易经卜卦 桌面占卜",
    "longDescription": "单应用双 Tab：塔罗镜（手动翻牌，三卡阵）与易经卜卦（64 卦）。占卜结果以 Markdown 复制并唤起 DeepSeek Web。",
    "iOS": {
      "developmentTeam": null,
      "minimumSystemVersion": "14.0"
    }
  }
}
